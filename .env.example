# ===========================================================================
# FixGenie Outreach System - Environment variables
# ---------------------------------------------------------------------------
# 1. Copy this file to ".env"      ->  cp .env.example .env
# 2. Fill in the values you have. EVERY key here is optional except where
#    noted, because the system degrades gracefully (e.g. if you have no
#    Google Places key it just uses the free OpenStreetMap source).
# 3. NEVER commit .env to git. It is already in .gitignore.
# ===========================================================================

# ---------------------------------------------------------------------------
# GOOGLE SHEETS  (required for storage)
# ---------------------------------------------------------------------------
# Path to the service-account JSON you download from Google Cloud Console.
# See docs/GOOGLE_SHEETS_SETUP.md for step-by-step instructions.
GOOGLE_SERVICE_ACCOUNT_JSON=./config/service_account.json
# The exact name (or key) of your Google Sheet.
GOOGLE_SHEET_NAME=FixGenie Leads Master

# ---------------------------------------------------------------------------
# DISCOVERY SOURCES
# ---------------------------------------------------------------------------
# OpenStreetMap Overpass - FREE, no key needed. Leave default unless you
# self-host your own Overpass instance.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Google Places API - OPTIONAL. Free $200/month credit. Get a key at
# https://console.cloud.google.com/  (enable "Places API").
# Leave blank to skip Google Places entirely.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# ENRICHMENT
# ---------------------------------------------------------------------------
# Hunter.io - OPTIONAL. Free tier = 25 searches + 50 verifications/month.
# Leave blank to rely only on the self-built website crawler (still works).
HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# EMAIL SENDING  (choose ONE provider: "gmail" or "brevo")
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=gmail

# -- Option 1: Gmail SMTP (free, ~500 sends/day) --
# Use a Google "App Password", NOT your real password.
# https://myaccount.google.com/apppasswords  (requires 2FA enabled)
GMAIL_ADDRESS=you@fixgenie.co
GMAIL_APP_PASSWORD=

# -- Option 2: Brevo (free, 300 sends/day) --
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# ---------------------------------------------------------------------------
# SENDER IDENTITY  (used in email footer - required for CAN-SPAM / CASL)
# ---------------------------------------------------------------------------
SENDER_NAME=Harmeet Singh
SENDER_COMPANY=FixGenie Consulting Inc
SENDER_EMAIL=hello@fixgenie.co
# A real, physical postal address is legally REQUIRED in every commercial email.
SENDER_POSTAL_ADDRESS=123 Example St, Suite 100, Toronto, ON, Canada
# Where unsubscribe requests are recorded/handled.
UNSUBSCRIBE_BASE_URL=https://fixgenie.co/unsubscribe

# ---------------------------------------------------------------------------
# SAFETY LIMITS
# ---------------------------------------------------------------------------
# Hard cap on emails sent per run, per mailbox. Protects deliverability.
DAILY_SEND_LIMIT=40
# Seconds to wait between sends (randomized +/- 40%) to look human.
SEND_DELAY_SECONDS=45
