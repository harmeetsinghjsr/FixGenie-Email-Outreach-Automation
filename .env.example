# ===========================================================================
# FixGenie Outreach System - Environment variables (TEMPLATE)
# ---------------------------------------------------------------------------
# 1. Copy this file to ".env"      ->  cp .env.example .env
# 2. Fill in the values you have. See the README "What you'll need" table for
#    where to get each key.
# 3. NEVER commit .env to git. It is already in .gitignore.
#
# Truly required to run end to end:
#   - GOOGLE_SERVICE_ACCOUNT_JSON + GOOGLE_SHEET_NAME   (storage)
#   - ONE email sender: Brevo (BREVO_API_KEY) or Gmail (GMAIL_*)
#   - SENDER_* identity fields                          (legal footer)
# Lead finding uses Exa via mcporter, which needs NO key here (see README).
# ===========================================================================

# ---------------------------------------------------------------------------
# GOOGLE SHEETS  (required for storage)
# ---------------------------------------------------------------------------
# Path to the service-account JSON from Google Cloud Console.
# Enable BOTH "Google Sheets API" and "Google Drive API", create a service
# account + JSON key, save it here, then SHARE your sheet (Editor) with the
# service account's client_email. See docs/GOOGLE_SHEETS_SETUP.md.
GOOGLE_SERVICE_ACCOUNT_JSON=./config/service_account.json
# The exact name of your Google Sheet (the app creates the tabs/columns).
GOOGLE_SHEET_NAME=FixGenie Leads Master

# ---------------------------------------------------------------------------
# DISCOVERY SOURCES
# ---------------------------------------------------------------------------
# OpenStreetMap Overpass - FREE, no key. Used by the legacy `discover` command.
# (The main lead finder is scripts/exa_leads.py, which uses Exa - no key here.)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Google Places API - OPTIONAL. Free $200/month credit. Enable "Places API" at
# https://console.cloud.google.com/ . Leave blank to skip.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# ENRICHMENT
# ---------------------------------------------------------------------------
# Hunter.io - OPTIONAL. Free tier ~= 25-50 searches + verifications/month.
# Finds/verifies more emails during `enrich`. Also set `use_hunter: true` in
# config/campaigns.yaml to use it. Get a key: https://hunter.io/api-keys
HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# LLM PERSONALIZATION  (OPTIONAL but recommended - scripts/personalize.py)
# ---------------------------------------------------------------------------
# Writes a clean company name + a tailored one-line opener for EACH lead, so
# emails read handwritten instead of templated. Uses an Anthropic-Messages-
# format gateway (POST {LLM_BASE_URL}/v1/messages). Works with providers like
# agentrouter.org, or the real Anthropic API (https://api.anthropic.com).
# Leave blank to skip personalization (templates still work, just less specific).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Some gateways only accept requests that look like the Claude CLI. Leave as-is
# unless your provider documents a different requirement.
LLM_USER_AGENT=claude-cli/1.0.60 (external)

# ---------------------------------------------------------------------------
# EMAIL SENDING  (choose ONE provider: "gmail" or "brevo")
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=brevo

# -- Option 1: Gmail SMTP (free, ~500 sends/day) --
# Use a Google "App Password", NOT your real password (requires 2FA):
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@yourdomain.com
GMAIL_APP_PASSWORD=

# -- Option 2: Brevo (free, 300 sends/day) - recommended for your own domain --
# IMPORTANT: use the API key that starts with "xkeysib-" (NOT the SMTP key
# "xsmtpsib-"): https://app.brevo.com/settings/keys/api
# You must ALSO (a) verify your sender address in Brevo, and (b) authenticate
# your DOMAIN in Brevo (add its DKIM CNAMEs + brevo-code TXT to your DNS) or
# mail bounces with a DMARC error. See README "Configure -> C".
BREVO_API_KEY=

# ---------------------------------------------------------------------------
# SENDER IDENTITY  (email footer - required for CAN-SPAM / CASL)
# ---------------------------------------------------------------------------
SENDER_NAME=Your Name
SENDER_COMPANY=Your Company Inc
SENDER_EMAIL=you@yourdomain.com
# A real, physical postal address is legally REQUIRED in every commercial email.
SENDER_POSTAL_ADDRESS=123 Example St, Suite 100, Your City, Region, Country
# Where unsubscribe requests are recorded/handled.
UNSUBSCRIBE_BASE_URL=https://yourdomain.com/unsubscribe

# ---------------------------------------------------------------------------
# SAFETY LIMITS
# ---------------------------------------------------------------------------
# Hard cap on emails sent per run. Keep it LOW at first (e.g. 20) to warm up a
# new sending domain and protect deliverability.
DAILY_SEND_LIMIT=20
# Seconds to wait between sends (randomized +/- 40%) to look human.
SEND_DELAY_SECONDS=45

# ---------------------------------------------------------------------------
# WEBHOOK SERVICE  (OPTIONAL - scripts/webhook_service.py, for n8n/ESP events)
# ---------------------------------------------------------------------------
# Shared secret for the webhook endpoints. If blank, auth is DISABLED (dev only)
# - always set this before exposing the service beyond localhost.
WEBHOOK_TOKEN=
# Port the webhook service listens on.
WEBHOOK_PORT=8080
